# ===== BRIDGE API CONFIGURATION =====
# Clé d'authentification pour les applications clientes
# Toutes les applications doivent utiliser cette clé pour s'authentifier
BRIDGE_API_KEY=your_bridge_api_key

# Clé pour authentifier les requêtes de callback envoyées aux applications clientes
# Cette clé sera envoyée en en-tête x-api-key lors du relai des webhooks
CLIENT_CALLBACK_API_KEY=your_client_callback_api_key

# Port de l'API
PORT=3000

# ===== SERDIPAY CREDENTIALS =====
SERDIPAY_MERCHANT_EMAIL=your_email
SERDIPAY_MERCHANT_PASSWORD=your_password
SERDIPAY_API_ID=your_api_id
SERDIPAY_API_PASSWORD=your_api_password
SERDIPAY_MERCHANT_CODE=your_merchant_code
SERDIPAY_MERCHANT_PIN=your_merchant_pin
